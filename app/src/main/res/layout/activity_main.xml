<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:layoutDirection="rtl">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:background="#FFFFFF">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <Button android:id="@+id/btnReciterMain" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="القارئ" android:textSize="12sp" android:layout_marginEnd="6dp"/>
            <Button android:id="@+id/btnDownloadAll" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:text="⬇️ تحميل المصحف كامل بدون نت" android:textSize="12sp"/>
        </LinearLayout>
        <ProgressBar android:id="@+id/progressAll" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="6236" android:visibility="gone"/>
        <TextView android:id="@+id/statusAll" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="13sp" android:textColor="@color/greenDark"/>
    </LinearLayout>
    <EditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="12dp" android:hint="@string/search" android:inputType="text" android:padding="12dp" android:background="@drawable/ayah_bg"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="match_parent"/>
</LinearLayout>
